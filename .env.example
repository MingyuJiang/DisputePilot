# Optional direct-backend configuration. This is NOT loaded by start.bat/start.sh.
# Copy to .env and use the documented uvicorn --env-file command.
# Defaults keep PayPal offline and writes disabled. Never commit a real .env.
DP_DATA_MODE=offline_replay
DP_AI_PROVIDER=frozen
DP_AUTO_IMPORT=0
DP_DATABASE_URL=sqlite:///data/integration.sqlite3
DP_STATIC_DIR=../frontend/dist
DP_DEMO_GOLDEN=../data/demo.golden.sqlite3

# Real AI is opt-in: change DP_AI_PROVIDER to ollama_local.
# Install your own Ollama runtime and model; only loopback URLs are supported.
DP_LLM_BASE_URL=http://127.0.0.1:11434
DP_LLM_MODEL=qwen3.6:35b-a3b-q4_K_M
DP_LLM_CONTEXT_LENGTH=4096
DP_LLM_TEMPERATURE=0.0
DP_LLM_SEED=42
DP_LLM_MAX_TOKENS=1800
DP_LLM_TIMEOUT_S=180
DP_LLM_RETRIES=0

# Real PayPal Sandbox reads are separate from real model inference.
# Set DP_DATA_MODE=paypal_sandbox and use a NEW database when opting in.
# Use your own Sandbox app credentials locally; blanks are intentional.
DP_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
DP_PAYPAL_CLIENT_ID=
DP_PAYPAL_CLIENT_SECRET=
DP_PAYPAL_TIMEOUT_S=15
DP_PAYPAL_READS_RETRY=0
DP_PAYPAL_WRITES_ENABLED=0
DP_PAYPAL_WRITE_ALLOW=
