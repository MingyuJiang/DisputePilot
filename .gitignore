# Repository exclusions: credentials, environments, and runtime state.

# Credentials and private environment configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.p7b
*.p7c
credentials.json
token.json
cookies*.json
secrets*.json
storage-state*.json
.ssh/
.aws/
.codex/

# Local dependencies, caches, builds
.venv/
venv/
node_modules/
frontend/dist/
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
*.tsbuildinfo
*.egg-info/
.coverage
htmlcov/
coverage/
*.log

# Runtime and local tools
backend/out/
backend/data/*.sqlite3
*.sqlite3
*.sqlite
*.db
data/backups/
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm
.tools/
.tooling/
.workbuddy/
.aws/
browser-profile/
playwright-profile/
research/

